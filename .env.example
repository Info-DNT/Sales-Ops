# =============================================================
# Sales Ops — Netlify environment variables
# =============================================================
# Set these in: Netlify → Site settings → Environment variables.
# This file is a template only. Never commit real values.
#
# The functions now FAIL CLOSED: if a secret below is missing, the
# function returns an error instead of falling back to a default.
# Set every variable its function needs before deploying.
# =============================================================


# ── Supabase ────────────────────────────────────────────────
# Service-role key: full DB access, bypasses RLS. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=https://lgedjkyafshufxhjywhk.supabase.co

# Anon (public) key. Required by crm-updater.js to verify the
# Supabase JWTs the web app sends. Safe to expose to browsers.
SUPABASE_ANON_KEY=


# ── Inbound webhook secrets ─────────────────────────────────
# NEW — required by netlify/functions/crm-receiver.js.
# ⚠️ Callers must send it as the `X-Webhook-Secret` header.
#    Configure this in Zoho Flow BEFORE deploying, or inbound
#    lead capture will start returning 401 and leads will be lost.
CRM_WEBHOOK_SECRET=

# Used by quotation-webhook.js and google-sheet-timeline-receiver.js.
# Previously defaulted to a value committed to source control; that
# fallback has been removed, so this must now be set explicitly.
WEBHOOK_SECRET=

# Pre-shared key for server-to-server calls to crm-updater.js
# (Postman / admin tooling), sent as the `x-api-key` header.
CRM_API_KEY=


# ── Zoho CRM ────────────────────────────────────────────────
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# One of: com | eu | in | au   (defaults to "in")
ZOHO_REGION=in


# ── Google ──────────────────────────────────────────────────
GOOGLE_DRIVE_API_KEY=

# Apps Script web-app URL and its shared token. Both are now required
# for Sheet logging; if either is unset, notify-signup.js skips the
# Sheet step rather than sending a hardcoded token.
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=


# ── WhatsApp (Whapi) ────────────────────────────────────────
WHAPI_API_TOKEN=
# Accounts team number for invoice/receipt requests, e.g. 919876543210
WHAPI_ACCOUNTS_PHONE=
# Admin number for new-signup alerts. Was hardcoded; now required.
WHAPI_ADMIN_PHONE=


# ── CORS ────────────────────────────────────────────────────
# Public site origin, e.g. https://salesops.example.com
# Used as Access-Control-Allow-Origin by crm-updater.js and
# zoho-proxy.js. Falls back to "*" when unset.
APP_DOMAIN=
